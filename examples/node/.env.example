# examples/node/.env.example
#
# Copy this file to .env in your working directory and `source .env`
# (or use direnv) before invoking the example scripts.
#
# The SDK does NOT load .env automatically — there is no dotenv dependency.
# This file is a template only.

# The indexer URL the example scripts connect to.
# Default: defaultIndexerUrl(Network.LocalNet) → http://localhost:12500
# Override to point at a non-default LocalNet or a public testnet indexer
# (e.g. https://ootle-indexer-a.tari.com for Network.Esmeralda).
OOTLE_INDEXER_URL=http://localhost:12500

# Override the LocalNet faucet component address. Defaults to the
# well-known LocalNet faucet — only set if your LocalNet uses a custom one.
# OOTLE_FAUCET_ADDRESS=component_010203...0000

# --- Script-specific env vars (not consumed by the SDK itself) ---
#
# watch-events.ts consumes these (see examples/node/README.md):
# OOTLE_COMPONENT_ADDRESS=component_<hex>      # required for watch-events
# OOTLE_EVENT_TOPIC=                            # optional filter
# OOTLE_WATCH_LIMIT=3                           # bound the watch loop
